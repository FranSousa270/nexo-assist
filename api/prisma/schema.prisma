
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  ANALYST
}

enum ConversationStatus {
  ACTIVE
  WAITING_ANALYST
  CLOSED
}

enum MessageRole {
  EMPLOYEE
  AGENT
  ANALYST
  SYSTEM
}

enum TicketType {
  INCIDENT
  REQUEST
}

enum TicketCategory {
  ACCESS
  NETWORK_VPN
  HARDWARE
  SOFTWARE
  EMAIL
  OTHER
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[] @relation("EmployeeConversations")
  assignedChats Conversation[] @relation("AnalystConversations")

  tickets       Ticket[] @relation("AffectedUserTickets")
  createdTickets Ticket[] @relation("CreatedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
}

model Conversation {
  id         String             @id @default(cuid())
  status     ConversationStatus @default(ACTIVE)
  employeeId String
  analystId  String?
  summary    String?
  messageCount Int               @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  closedAt   DateTime?

  employee User  @relation("EmployeeConversations", fields: [employeeId], references: [id])
  analyst  User? @relation("AnalystConversations", fields: [analystId], references: [id])

  messages  Message[]
  decisions AgentDecision[]
  tickets   Ticket[]

  @@index([employeeId, status])
  @@index([analystId, status])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentDecision {
  id             String   @id @default(cuid())
  conversationId String
  action         String
  rationale      String
  confidence     Float?
  details        Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Ticket {
  id             String         @id @default(cuid())
  number         String         @unique
  title          String
  description    String
  type           TicketType
  category       TicketCategory
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  affectedUserId String
  createdById    String
  assignedToId   String?
  conversationId String?
  dueAt          DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  affectedUser User  @relation("AffectedUserTickets", fields: [affectedUserId], references: [id])
  createdBy    User  @relation("CreatedTickets", fields: [createdById], references: [id])
  assignedTo   User? @relation("AssignedTickets", fields: [assignedToId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([affectedUserId, status])
  @@index([status, priority, dueAt])
  @@index([conversationId])
}

model KnowledgeArticle {
  id        String         @id @default(cuid())
  title     String
  content   String
  category  TicketCategory
  published Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([category, published])
}
